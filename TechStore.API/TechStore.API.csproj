<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>TechStore.API</RootNamespace>
	</PropertyGroup>
	<ItemGroup>
		<!-- Starting text of the policy pages (PolicyService) -->
		<EmbeddedResource Include="Content\Policies\*.md" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
		<PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
		<PackageReference Include="FluentValidation.AspNetCore" Version="11.3.1" />
		<PackageReference Include="SkiaSharp" Version="3.116.1" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
		<PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
		<PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.2" />
		<PackageReference Include="Azure.Identity" Version="1.21.0" />
		<PackageReference Include="Azure.Communication.Email" Version="1.1.0" />
		<!-- Microsoft.Data.SqlClient (via EF Core) brings 9.0.11, which has known vulnerabilities -->
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
	</ItemGroup>
</Project>